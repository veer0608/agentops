# --- AgentOps configuration -------------------------------------------------
# Copy to `.env` and fill in. Leave the selected provider's key unset to build
# and test with the offline demo model (no network, no credentials required).

# Model provider: "openai", "anthropic", or "google".
PROVIDER=openai

# OpenAI (used when PROVIDER=openai). The SDK also reads OPENAI_API_KEY directly.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic (used when PROVIDER=anthropic).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Google Gemini (used when PROVIDER=google; via Google's OpenAI-compatible endpoint).
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Anthropic effort / reserved for reasoning models.
EFFORT=medium

# Doc-search backend: "stub" (deterministic offline) or "citerag" (HTTP).
DOC_SEARCH_MODE=stub
CITERAG_URL=http://127.0.0.1:8000

# Safety rail: max model turns per conversation before the loop stops.
MAX_AGENT_STEPS=8
